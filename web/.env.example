# Pi Durable on exe.dev. The browser never calls this URL.
# Local: http://127.0.0.1:8000
# VM:    https://<vm>.exe.xyz
PI_AGENT_URL=http://127.0.0.1:8000

# Local agent: the AGENT_TOKEN from agent/agent.env.
# exe.dev VM: a VM HTTPS token (ssh exe.dev ssh-key generate-api-key --vm=<vm>).
# Sent as X-Exedev-Authorization when PI_AGENT_URL is an exe.xyz host.
PI_AGENT_TOKEN=
