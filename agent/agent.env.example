# Direct OpenRouter. Keep this off the VM if you can.
OPENROUTER_API_KEY=

# Optional. Point at an exe.dev LLM integration that stores the OpenRouter key
# at the edge, and set OPENROUTER_API_KEY=exe-llm-integration.
# OPENROUTER_BASE_URL=https://openrouter.int.exe.xyz/api/v1

# Shared with the Vercel server for local runs. Unused when exe.dev login
# sets X-ExeDev-Email.
AGENT_TOKEN=

# Financial Datasets. Stays on this process. Do not put it in web/ or Vercel.
# Create a key at https://financialdatasets.ai. Data calls return 402 until
# the account is funded.
FINANCIAL_DATASETS_API_KEY=

# SubQ Snap 1.1. Optimize mode uses this for relevance judgments.
SUBQ_API_KEY=

# Observability only. Conversation state stays in SQLite.
# Leave unset to skip the log. Database aie, collection events.
MONGODB_URI=

PORT=8000
